# 複製成 .env 後填入。.env 不要 commit。

# ---- 內部 LLM（OpenAI 相容 chat completions，需支援 tool calling）----
LLM_BASE_URL=https://llm.internal.example.com/v1
LLM_API_KEY=changeme
LLM_MODEL=your-model-name
# LLM_TEMPERATURE=0
# LLM_TIMEOUT_S=120

# ---- Prometheus MCP server ----
# HTTP（建議：MCP server 跑在叢集內，開 Streamable HTTP）
PROM_MCP_TRANSPORT=streamable_http
PROM_MCP_URL=http://prometheus-mcp.artex.svc:8080/mcp
# PROM_MCP_HEADERS={"Authorization": "Bearer xxx"}
# 只載入需要的工具（逗號分隔；空 = 全部）。先跑 python main.py --check 看有哪些工具
# PROM_MCP_TOOLS=execute_query,execute_range_query,list_metrics,get_metric_metadata

# 或用 stdio 在本機啟動 MCP server（例：uvx / docker）
# PROM_MCP_TRANSPORT=stdio
# PROM_MCP_COMMAND=docker
# PROM_MCP_ARGS=run,-i,--rm,-e,PROMETHEUS_URL,ghcr.io/pab1it0/prometheus-mcp-server:latest
# PROM_MCP_ENV={"PROMETHEUS_URL": "http://prometheus.monitoring:9090"}

# ---- Kubernetes（唯讀 ServiceAccount 的 kubeconfig）----
# KUBECONFIG=C:\Users\you\.kube\sre-readonly.yaml
# KUBE_CONTEXT=test-cluster

# ---- 防護與預算 ----
# PROM_BUDGET_PER_TASK=10
# PROM_BUDGET_TOTAL=80
# MAX_PARALLEL_WORKERS=3
# GATE_MAX_RETRIES=3
# TASK_TIMEOUT_S=900
# RECURSION_LIMIT=200
# OUTPUT_DIR=reports
